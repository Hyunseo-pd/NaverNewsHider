{
  "manifest_version": 3,
  "name": "BetterNaver",
  "description": "Hides content in Naver main page.",
  "version": "1.0",
  "action": {
    "default_icon": {
      "16": "icon/icon16.png",
      "32": "icon/icon32.png",
      "48": "icon/icon48.png",
      "128": "icon/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.naver.com/*"],
      "js": ["contentscript.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["*://*.naver.com/*"]
}
